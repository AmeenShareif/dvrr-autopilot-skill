# Public.com API Credentials
# Supported names:
# PUBLIC_API_SECRET or PUBLIC_COM_SECRET
# PUBLIC_ACCOUNT_ID or PUBLIC_COM_ACCOUNT_ID
PUBLIC_API_SECRET=your-secret-key-here
PUBLIC_ACCOUNT_ID=your-account-id-here

# Polygon.io API Key (for market data)
POLYGON_API_KEY=your-polygon-key-here

# DVRR Configuration
DVRR_MODE=ANALYZE
DVRR_RISK_PER_TRADE=0.02
DVRR_MAX_POSITION_PCT=0.10
DVRR_TARGET_SYMBOL=
